# syntax=docker/dockerfile:1
#
# Multi-stage image for the RQ worker. The shape mirrors the API image so the
# two are easy to read side by side; only the entrypoint and healthcheck differ.

FROM python:3.14-slim AS builder

# uv is pinned by version and copied from its official image; it does not reach
# the runtime stage.
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev

COPY app ./app
COPY worker ./worker
COPY migrations ./migrations


FROM python:3.14-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    TMPDIR=/tmp \
    WOMM_QUEUE_NAME=certificates

RUN groupadd --system --gid 10001 womm \
 && useradd --system --uid 10001 --gid womm --home-dir /app --shell /usr/sbin/nologin womm

WORKDIR /app

COPY --from=builder --chown=womm:womm /app/.venv /app/.venv
COPY --from=builder --chown=womm:womm /app/app ./app
COPY --from=builder --chown=womm:womm /app/worker ./worker
COPY --from=builder --chown=womm:womm /app/migrations ./migrations
COPY --chown=womm:womm docker/entrypoint-worker.sh /usr/local/bin/entrypoint-worker.sh
RUN chmod +x /usr/local/bin/entrypoint-worker.sh

USER womm:womm

# Readiness probe: `rq info` opens a Redis connection and exits non-zero if it
# cannot. The start period allows for a cold connection to Redis. Exec form (via
# `sh -c`) keeps the shell redirection without tripping hadolint's DL3025.
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD ["sh", "-c", "rq info --url \"${WOMM_REDIS_URL}\" > /dev/null || exit 1"]

ENTRYPOINT ["/usr/local/bin/entrypoint-worker.sh"]
